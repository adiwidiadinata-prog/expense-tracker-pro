# ============================================
# Expense Tracker Pro - Backend Environment
# Copy ke .env dan isi nilainya
# JANGAN commit file .env ke GitHub!
# ============================================

# Server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
FRONTEND_URL=https://expense-tracker-pro-h4ru.vercel.app

# Firebase Admin SDK
# Download dari: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=expense-tracker-pro-99692
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@expense-tracker-pro-99692.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nXXXXX\n-----END RSA PRIVATE KEY-----\n"

# JWT Authentication
JWT_SECRET=ganti-dengan-string-random-minimal-32-karakter
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# Midtrans Payment Gateway
# Daftar di: https://app.midtrans.com
# Sandbox: https://app.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXXXXXX
MIDTRANS_ENV=sandbox
# Untuk production: ubah ke Mid-server-xxx (tanpa SB-)
# MIDTRANS_ENV=production

# Email (Gmail SMTP)
# Buat App Password di: Google Account → Security → 2FA → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adiwidiadinata@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Subscription Pricing (IDR)
PRICE_MONTHLY=25000
PRICE_ANNUAL=250000
FREE_TRIAL_DAYS=14
MAX_FREE_EXPENSES=50
MAX_FREE_USERS=2

# Security
ENCRYPTION_KEY=32-karakter-random-untuk-enkripsi
CORS_ORIGINS=https://expense-tracker-pro-h4ru.vercel.app,http://localhost:5500
