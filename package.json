{
  "name": "expense-tracker-pro",
  "version": "1.0.0",
  "description": "Secure Progressive Web App for Business Expense Tracking",
  "main": "expense-tracker-secured.html",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "test:e2e": "jest test/e2e",
    "test:security": "jest test/security",
    "test:performance": "jest test/performance",
    "lint": "eslint .",
    "start": "http-server",
    "deploy": "vercel --prod"
  },
  "keywords": [
    "expense-tracking",
    "pwA",
    "firebase",
    "business",
    "accounting"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "firebase": "^10.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.0",
    "@testing-library/html": "^9.3.0",
    "eslint": "^8.54.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vercel": "^32.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "expense-tracker-secured.html"
    ],
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
